# Production environment configuration for WayMates
# Copy this file to .env.prod and fill with real values

# Neo4j Authentication
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_production_password_here

# Neo4j Connection (Production port)
NEO4J_PORT=7687
NEO4J_URI=bolt://localhost:${NEO4J_PORT}

# Neo4j Memory Settings (Production optimized)
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m
NEO4J_HTTP_PORT=7474

# Core REST API
CORE_PORT=9000
CORE_HOST=0.0.0.0
CORE_API_URL=http://localhost:9000/api

# Redis (Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL (LangGraph Checkpointing for Facade)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_production_password_here
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_DB=waymates_facade

# Google API (Gemini LLM)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI / OpenRouter (LLM Translator - optional)
OPENAI_API_KEY=your_openai_key_here
# For OpenRouter (optional):
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Logging
LOG_LEVEL=info

# Sentry Error Monitoring (Telegram alerts)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
