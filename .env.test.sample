# Testing environment configuration for WayMates
# Copy this file to .env.test and fill with real values
# Used for integration and functional tests (unit tests don't use DB)

# Neo4j Authentication
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_test_password_here

# Neo4j Connection (Testing port)
NEO4J_PORT=7689
NEO4J_URI=bolt://localhost:${NEO4J_PORT}

# Neo4j Memory Settings (Testing optimized - smaller for faster startup)
NEO4J_HEAP_INITIAL=256m
NEO4J_HEAP_MAX=512m
NEO4J_PAGECACHE=256m
NEO4J_HTTP_PORT=7476

# Core REST API
CORE_PORT=9001
CORE_HOST=0.0.0.0
CORE_API_URL=http://localhost:9001/api

# Redis (Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenAI / OpenRouter (LLM Translator)
OPENAI_API_KEY=your_openai_key_here
# For OpenRouter (optional):
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
