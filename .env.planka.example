# Planka Self-hosted Configuration
# Copy to .env.planka and customize
#
# Services run on host network with custom ports (VPN-friendly):
# - PostgreSQL: 5434 (not 5432, to avoid conflicts with Plane: 5433, WayMates: 7689)
# - Planka Web UI: 3000 (not 3080 like Plane)

# Database
PLANKA_DB_PASSWORD=planka_secure_password_123

# Application
PLANKA_BASE_URL=http://localhost:3000
PLANKA_TRUST_PROXY=0
PLANKA_SECRET_KEY=change-this-to-random-secret-min-32-chars-abcdef123456

# Default Admin Account (created on first run)
# You can change these after first login via UI
PLANKA_ADMIN_EMAIL=admin@planka.local
PLANKA_ADMIN_PASSWORD=admin123
PLANKA_ADMIN_NAME=Administrator
PLANKA_ADMIN_USERNAME=admin

# MCP Server Configuration (for kanban-mcp)
# Use these credentials in .mcp.json after first run
PLANKA_AGENT_EMAIL=admin@planka.local
PLANKA_AGENT_PASSWORD=admin123
