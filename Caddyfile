# Caddy reverse proxy for WayMates

# Main domain - landing/bot (future)
waymates.duckdns.org {
    respond "WayMates - Coming Soon" 200
}

# Subdomain for Structurizr (C4 diagrams) - MUST be root path
arch.waymates.duckdns.org {
    reverse_proxy localhost:8080 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
}
