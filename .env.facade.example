# Facade MCP Server Environment Variables

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Core API configuration
CORE_API_URL=http://localhost:9000/api

# PostgreSQL configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=waymates123
POSTGRES_DB=waymates_facade
POSTGRES_POOL_MAX=20

# OpenAI/OpenRouter configuration
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
OPENAI_API_BASE=https://openrouter.ai/api/v1
LANGCHAIN_MODEL_NAME=google/gemini-2.0-flash

# Rate limiting
OPENAI_FACADE_RPM_LIMIT=500
OPENAI_FACADE_MAX_CONCURRENT=10

# Neo4j pooling (optional - defaults to 50)
# NEO4J_MAX_POOL_SIZE=50