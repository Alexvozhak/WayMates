#!/bin/sh

echo "🔍 Running pre-commit checks..."

# 1. Lint staged files (always)
echo "📝 Running lint-staged..."
npx lint-staged || exit 1

# 2. TypeScript type checking (always, fast)
echo "🔎 Running TypeScript type check..."
npx tsc --noEmit || exit 1

# 3. Integration tests (only if src/core changed)
if git diff --cached --name-only | grep -q "^src/core/"; then
  echo "📦 Core changes detected, running integration tests..."
  npm run test:integration || exit 1
else
  echo "✅ No core changes, skipping integration tests"
fi

echo "✅ All pre-commit checks passed!"
