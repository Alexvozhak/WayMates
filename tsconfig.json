{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File layout
    "rootDir": ".", // project sources (including scripts)
    "outDir": "dist", // build output directory (not used yet)
    "baseUrl": ".",
    "paths": {
      "#prompts/*": ["./private/prompts/*"],
      "#core/*": ["./private/core/*"],
      "#cypher/*": ["./private/cypher/*"],
      "#database/*": ["./private/database/*"],
      "#shared/*": ["./src/shared/*"],
      "#private/schemas.js": ["./private/schemas.ts"]
    },

    // Target Node environment (ESM)
    "module": "nodenext", // Node 24 ESM
    "target": "ES2024", // Node 24 LTS
    "moduleResolution": "nodenext", // Module resolution as Node ESM

    // Convenience
    "resolveJsonModule": true, // Import .json files
    "esModuleInterop": true, // Convenient CommonJS module imports
    "allowSyntheticDefaultImports": true, // Allow synthetic default imports

    // Strict type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,

    // For correct tsx runner operation
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "generated/**/*.ts", "private/**/*.ts", "vitest.config.ts", "vitest.globalSetup.ts"],
  "exclude": ["src_old", "dist", "node_modules", "poc"]
}
