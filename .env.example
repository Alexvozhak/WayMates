# LangChain Model Configuration (Optional - validated via Zod in facade/env.ts)
# Defaults: MODEL_NAME=models/gemini-2.0-flash, TEMP_EXTRACTION=0.2, TEMP_INTENT=0.1, TEMP_AGENT=0.3
# Uncomment to override:
# LANGCHAIN_MODEL_NAME=models/gemini-2.0-flash
# LANGCHAIN_TEMP_EXTRACTION=0.2  # Data extraction (0.0-1.0, slightly creative)
# LANGCHAIN_TEMP_INTENT=0.1      # Intent classification (0.0-1.0, very deterministic)
# LANGCHAIN_TEMP_AGENT=0.3       # Agent orchestration (0.0-1.0, balanced)

# Telegram Bot Configuration (Required for telegram-bot module)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
FACADE_MCP_URL=http://localhost:3000/mcp
OPENAI_API_KEY=your_openai_api_key
NODE_ENV=development

# LLM Formatter Configuration (Optional - for search results formatting)
# FORMATTER_LLM_MODEL=gpt-4o-mini
# FORMATTER_LLM_TEMPERATURE=0.7
