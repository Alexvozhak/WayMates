# Sample environment configuration for WayMates Neo4j
# Copy this file to .env.prod, .env.integration, .env.functional and fill with real values

# Neo4j Authentication
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Neo4j Connection
NEO4J_URI=bolt://localhost:7687

# Neo4j Memory Settings  
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m
