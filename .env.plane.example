# Plane Self-hosted Configuration
# Copy to .env.plane and customize
#
# Services run on host network with custom ports (VPN-friendly):
# - PostgreSQL: 5433 (not 5432, to avoid conflicts)
# - Redis: 6380 (not 6379)
# - MinIO: 9001/9091 (not 9000/9090)
# - Plane API: 8000 (default)
# - Plane Web UI: 3080

# Database
PLANE_DB_PASSWORD=plane_secure_password_123

# Application
PLANE_WEB_URL=http://localhost:3080
PLANE_SECRET_KEY=change-this-to-random-secret-min-50-chars-abcdef123456789

# MinIO Storage (object storage for file uploads)
MINIO_ROOT_USER=plane
MINIO_ROOT_PASSWORD=plane_minio_password_123
MINIO_BUCKET_NAME=plane-uploads

# Email (optional - для уведомлений и приглашений)
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_PORT=587
EMAIL_FROM=noreply@plane.local
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# Feature Flags
ENABLE_SIGNUP=1
ENABLE_EMAIL_PASSWORD=1
ENABLE_MAGIC_LINK_LOGIN=0

# Plane API for MCP Server (fill after first login)
# Get this: Settings → API Tokens → Create API Token
PLANE_API_KEY=plane_api_key_xxxxxxxxxxxxxxxx
PLANE_API_URL=http://localhost:8000/api
