import { describe, test, expect, beforeEach, afterEach, vi } from "vitest";
import type { Driver, Session } from "neo4j-driver";
import { join } from "path";
import { loadTestData } from "../helpers/test-data-loader.js";
import {
  AvatarResearchResultSchema,
  CurrentToTargetResultSchema,
  TargetAnalysisResultSchema,
  AvatarSearchResultSchema,
  SearchConstraints,
} from "../../src/schemas-zod.js";
import {
  setupIntegrationTest,
  teardownIntegrationTest,
} from "../helpers/database-setup.js";

const clone = <T>(value: T): T =>
  typeof globalThis.structuredClone === "function"
    ? globalThis.structuredClone(value)
    : JSON.parse(JSON.stringify(value));

const fastMCPInstances: MockFastMCP[] = [];

class MockFastMCP {
  public tools: Array<{
    name: string;
    description?: string;
    execute: (args: unknown) => Promise<string>;
  }> = [];

  constructor(public options: Record<string, unknown>) {
    fastMCPInstances.push(this);
  }

  addTool(tool: (typeof this.tools)[number]) {
    this.tools.push(tool);
  }

  addPrompt() {}
  addResource() {}
  addResourceTemplate() {}
}

vi.mock("fastmcp", () => ({
  FastMCP: MockFastMCP,
}));

const getTool = (name: string) => {
  const instance = fastMCPInstances.at(-1);
  if (!instance) {
    throw new Error("FastMCP instance was not created");
  }
  const tool = instance.tools.find((candidate) => candidate.name === name);
  if (!tool) {
    throw new Error(`Tool ${name} was not registered`);
  }
  return tool;
};

const { createWayMatesServer } = await import("../../src/mcp-server.js");
import { PRESETS } from "../../src/generated/presets.generated.js";

const BASE_SEARCH_CONSTRAINTS: SearchConstraints = {
  max_timing_diff_months: 12,
  timing_diff_threshold_percent: 25,
  max_experience_diff_months: 48,
  results_limit: 10,
};

describe("MCP tools integration", () => {
  let driver: Driver;
  let session: Session;

  beforeEach(async () => {
    fastMCPInstances.length = 0;
    ({ driver, session } = await setupIntegrationTest());
    createWayMatesServer(driver, PRESETS);
  });

  afterEach(async () => {
    await teardownIntegrationTest(session, driver);
  });

  test("execute_upsert_story imports full story graph", async () => {
    const story = loadTestData("USER_001");
    const upsertStoryTool = getTool("execute_upsert_story");

    const response = await upsertStoryTool.execute(story);
    expect(() => JSON.parse(response)).not.toThrow();

    const { records } = await session.executeRead((tx) =>
      tx.run(
        `
          MATCH (u:User {user_id: $userId})-[:HAS_CONTEXT]->(c:Context)
          MATCH (u)-[:HAS_TRAIL]->(t:Trail)
          RETURN count(DISTINCT c) AS contexts, count(DISTINCT t) AS trails
        `,
        { userId: story.user_id }
      )
    );

    expect(Number(records[0]?.get("contexts"))).toBe(story.contexts.length);
    expect(Number(records[0]?.get("trails"))).toBe(story.trails.length);
  });

  test("upsert_context and upsert_trail add nodes and relationships", async () => {
    const story = loadTestData("USER_002");
    const upsertContextTool = getTool("upsert_context");
    const upsertTrailTool = getTool("upsert_trail");

    await upsertContextTool.execute({
      user_id: story.user_id,
      contexts: story.contexts.slice(0, 2),
    });

    const contextResult = await session.executeRead((tx) =>
      tx.run(
        `
          MATCH (u:User {user_id: $userId})-[:HAS_CONTEXT]->(c:Context)
          RETURN collect({
            context_id: c.context_id,
            position: c.position,
            industry: c.industry
          }) AS contexts
        `,
        { userId: story.user_id }
      )
    );

    const contexts = contextResult.records[0]?.get("contexts") as Array<{
      context_id: string;
      position: string;
      industry: string;
    }>;
    expect(contexts).toHaveLength(2);

    const matchContextId = (position: string) =>
      contexts.find((item) => item.position === position)?.context_id;

    const firstTrail = clone(story.trails[0]!);
    firstTrail.from_context_id = matchContextId(story.contexts[0]!.position)!;
    firstTrail.to_context_id = matchContextId(story.contexts[1]!.position)!;

    await upsertTrailTool.execute({
      user_id: story.user_id,
      trails: [firstTrail],
    });

    const trailResult = await session.executeRead((tx) =>
      tx.run(
        `
          MATCH (u:User {user_id: $userId})-[:HAS_TRAIL]->(t:Trail)
          RETURN collect({ trail_id: t.trail_id, skill: t.skill }) AS trails
        `,
        { userId: story.user_id }
      )
    );

    const trails = trailResult.records[0]?.get("trails") as Array<{
      trail_id: string;
      skill: string;
    }>;
    expect(trails).toHaveLength(1);
    expect(trails[0]!.skill).toBe(firstTrail.skill);
  });

  test("target_search executes against inserted data", async () => {
    const story = loadTestData("USER_003");
    await getTool("execute_upsert_story").execute(story);

    const searchConstraints = {
      ...BASE_SEARCH_CONSTRAINTS,
      results_limit: 5,
    } as const;

    const targetSearchTool = getTool("target_search");
    const resultJson = await targetSearchTool.execute({
      targetContext: story.contexts.at(-1)!,
      searchConstraints,
    });

    const parsed = JSON.parse(resultJson);
    expect(Array.isArray(parsed)).toBe(true);
    parsed.forEach((entry: unknown) => {
      expect(() => AvatarSearchResultSchema.parse(entry)).not.toThrow();
    });
    expect(
      parsed.some(
        (entry: { user_id?: string }) => entry.user_id === story.user_id
      )
    ).toBe(true);
  });

  test("current_only surfaces progression insights for newly imported user", async () => {
    const story = loadTestData("USER_004");
    await getTool("execute_upsert_story").execute(story);

    const currentContext = story.contexts[0];
    if (!currentContext) {
      throw new Error("USER_004 must include at least one context");
    }

    // 📝 БИЗНЕС-СЦЕНАРИЙ: Анализируем, как пользователь развивался после текущего контекста
    const response = await getTool("current_only").execute({
      currentContext,
      lookAheadMonths: 18,
      reasonsToTrack: currentContext.creation_reason,
      searchConstraints: { ...BASE_SEARCH_CONSTRAINTS, results_limit: 10 },
      maxUsers: 5,
    });

    const parsed = JSON.parse(response);
    expect(Array.isArray(parsed)).toBe(true);
    expect(parsed.length).toBeGreaterThan(0);
    parsed.forEach((entry: unknown) => {
      const validated = AvatarResearchResultSchema.parse(entry);
      expect(validated.userId).toBe(story.user_id);
    });
  });

  test("current_to_target finds transition plan for imported story", async () => {
    const story1 = loadTestData("USER_002");
    const story2 = loadTestData("USER_003");
    const story3 = loadTestData("USER_004");

    await getTool("execute_upsert_story").execute(story1);
    await getTool("execute_upsert_story").execute(story2);
    await getTool("execute_upsert_story").execute(story3);

    const [currentContext, targetContext] = story1.contexts.slice(0, 2);
    if (!currentContext || !targetContext) {
      throw new Error("USER_002 must include at least two contexts");
    }

    const response = await getTool("current_to_target").execute({
      currentContext,
      targetContext,
      searchConstraints: { ...BASE_SEARCH_CONSTRAINTS, results_limit: 8 },
    });

    const parsed = JSON.parse(response);
    expect(Array.isArray(parsed)).toBe(true);
    expect(parsed.length).toBeGreaterThan(0);
    parsed.forEach((entry: unknown) => {
      const validated = CurrentToTargetResultSchema.parse(entry);
      // Мы ищем ДРУГИХ пользователей, у которых есть и current, и target контексты
      expect(validated.userId).not.toBe(story1.user_id);
      expect(validated.trailPath.length).toBeGreaterThanOrEqual(0); // trailPath может быть пустым
    });
  });

  test("target_only aggregates achiever statistics for target context", async () => {
    const story = loadTestData("USER_006");
    await getTool("execute_upsert_story").execute(story);

    const targetContext = story.contexts.at(-1);
    if (!targetContext) {
      throw new Error("USER_006 must include at least one context");
    }

    // 📝 БИЗНЕС-СЦЕНАРИЙ: Собираем агрегированные метрики по достижениям целевой роли
    const response = await getTool("target_only").execute({
      targetContext,
      searchConstraints: { ...BASE_SEARCH_CONSTRAINTS, results_limit: 15 },
    });

    const parsed = JSON.parse(response);
    const validated = TargetAnalysisResultSchema.parse(parsed);
    expect(validated.targetPosition).toBe(targetContext.position);
    expect(validated.totalAvatarsFound).toBeGreaterThan(0);
    expect(validated.achievementPaths.length).toBeGreaterThan(0);
  });

  test("get_user_story returns stored contexts and trails", async () => {
    const story = loadTestData("USER_003");
    await getTool("execute_upsert_story").execute(story);

    const getStoryTool = getTool("get_user_story");
    const response = await getStoryTool.execute({ user_id: story.user_id });
    const parsed = JSON.parse(response);

    expect(parsed.user_id).toBe(story.user_id);
    expect(parsed.contexts).toHaveLength(story.contexts.length);
    expect(parsed.trails).toHaveLength(story.trails.length);
  });

  test("delete_trail removes trail owned by user", async () => {
    const story = loadTestData("USER_005");
    await getTool("execute_upsert_story").execute(story);

    const trailBefore = await session.executeRead((tx) =>
      tx.run(
        `MATCH (u:User {user_id: $userId})-[:HAS_TRAIL]->(t:Trail)
         RETURN t.trail_id AS id
         ORDER BY id
         LIMIT 1`,
        { userId: story.user_id }
      )
    );

    const trailId = trailBefore.records[0]!.get("id");

    const deleteTrailResponse = await getTool("delete_trail").execute({
      user_id: story.user_id,
      trail_id: trailId,
    });
    expect(JSON.parse(deleteTrailResponse)).toEqual({ deleted: true });

    const trailAfter = await session.executeRead((tx) =>
      tx.run(
        `MATCH (u:User {user_id: $userId})-[:HAS_TRAIL]->(t:Trail {trail_id: $trailId})
         RETURN count(t) AS remaining`,
        { userId: story.user_id, trailId }
      )
    );

    expect(Number(trailAfter.records[0]?.get("remaining") ?? 0)).toBe(0);
  });

  test("delete_context prevents removal when trails exist", async () => {
    const story = loadTestData("USER_001");
    await getTool("execute_upsert_story").execute(story);

    const existingContextId = await session.executeRead((tx) =>
      tx.run(
        `MATCH (u:User {user_id: $userId})-[:HAS_CONTEXT]->(c:Context)
         RETURN c.context_id AS id
         ORDER BY c.created_at
         LIMIT 1`,
        { userId: story.user_id }
      )
    );

    const contextId = existingContextId.records[0]!.get("id");

    await expect(
      getTool("delete_context").execute({
        user_id: story.user_id,
        context_id: contextId,
      })
    ).rejects.toThrow();
  });

  test("delete_context removes standalone context", async () => {
    const story = loadTestData("USER_002");
    await getTool("execute_upsert_story").execute(story);

    const upsertContextTool = getTool("upsert_context");
    const templateContext = clone(story.contexts[0]);
    templateContext.created_at = "2030-01-01T00:00:00Z";
    templateContext.context_id = "ctx_temp";

    await upsertContextTool.execute({
      user_id: story.user_id,
      contexts: [templateContext],
    });

    const newContextRecord = await session.executeRead((tx) =>
      tx.run(
        `MATCH (u:User {user_id: $userId})-[:HAS_CONTEXT]->(c:Context)
         WHERE c.created_at = datetime($createdAt)
         RETURN c.context_id AS id`,
        { userId: story.user_id, createdAt: templateContext.created_at }
      )
    );

    const newContextId = newContextRecord.records[0]!.get("id");

    const deleteContextResponse = await getTool("delete_context").execute({
      user_id: story.user_id,
      context_id: newContextId,
    });

    expect(JSON.parse(deleteContextResponse)).toEqual({ deleted: true });

    const verifyDeletion = await session.executeRead((tx) =>
      tx.run(
        `MATCH (u:User {user_id: $userId})-[:HAS_CONTEXT]->(c:Context {context_id: $contextId})
         RETURN count(c) AS remaining`,
        { userId: story.user_id, contextId: newContextId }
      )
    );

    expect(Number(verifyDeletion.records[0]?.get("remaining") ?? 0)).toBe(0);
  });

  test("ping tool returns ok status", async () => {
    const pingResponse = await getTool("ping").execute({});
    const parsed = JSON.parse(pingResponse);
    expect(parsed.status).toBe("ok");
    expect(typeof parsed.timestamp).toBe("string");
  });
});
