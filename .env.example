# WayMates Environment Configuration
# Copy to .env.test (testing) or .env (production)
# NO DEFAULTS in code — all required values must be explicit

# =============================================================================
# NEO4J (Core database)
# =============================================================================
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
# Memory settings (adjust for your environment)
NEO4J_HEAP_INITIAL=256m
NEO4J_HEAP_MAX=512m
NEO4J_PAGECACHE=256m
NEO4J_MAX_POOL_SIZE=50

# =============================================================================
# POSTGRESQL (Facade checkpointing)
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=waymates_facade
POSTGRES_POOL_MAX=20

# =============================================================================
# REDIS (Sessions, rate limiting)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# =============================================================================
# CORE API
# =============================================================================
CORE_PORT=9000
CORE_API_URL=http://localhost:9000

# =============================================================================
# FACADE MCP SERVER
# =============================================================================
FACADE_TRANSPORT=http
FACADE_HTTP_PORT=3001
FACADE_MCP_URL=http://localhost:3001/mcp

# Dictionary cache
DICT_CACHE_TTL_SECONDS=86400
DICT_HINTS_MAX_SKILLS=50

# Search limits
CANDIDATES_FETCH_LIMIT=50
CANDIDATES_DISPLAY_LIMIT=10

# Facets threshold (Progressive Disclosure)
FACETS_MAX_CANDIDATES=10
FACETS_MAX_JSON_SIZE_KB=100

# Auth
AUTH_SESSION_TTL_SECONDS=3600

# CV parser
CV_PARSER_MODEL=google/gemini-2.5-flash
CV_PARSER_MAX_FILE_SIZE_MB=10
CV_PARSER_MAX_OUTPUT_TOKENS=4000
CV_PARSER_TEMPERATURE=0.1

# Documentary
DOCS_PATH=./docs/presentation

# =============================================================================
# LLM CONFIGURATION (OpenRouter)
# =============================================================================
OPENAI_API_KEY=your_openrouter_key_here
OPENAI_API_BASE=https://openrouter.ai/api/v1
LANGCHAIN_MODEL_NAME=openai/gpt-4o-mini
LANGCHAIN_TIMEOUT_MS=60000

# Temperature settings (0.0-1.0)
LANGCHAIN_TEMP_DETERMINISTIC=0
LANGCHAIN_TEMP_EXTRACTION=0.2
LANGCHAIN_TEMP_PLANNING=0.1
LANGCHAIN_TEMP_AGENT=0.3

# Clarification limits
LANGCHAIN_MAX_CLARIFICATION_ROUNDS=5
LANGCHAIN_MAX_QUESTIONS_PER_BATCH=5

# Rate limiting
OPENAI_FACADE_RPM_LIMIT=500
OPENAI_FACADE_MAX_CONCURRENT=10

# =============================================================================
# TELEGRAM BOT
# =============================================================================
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=@YourBot
# Session string (for GramJS testing)
# TELEGRAM_SESSION=your_session_string_here

# =============================================================================
# CLOUDFLARE R2 (Required for chart service)
# =============================================================================
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket
R2_PUBLIC_URL=https://your-bucket.r2.dev
R2_TTL_DAYS=30

# =============================================================================
# MONITORING (Optional)
# =============================================================================
LOG_LEVEL=info
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# LANGSMITH_API_KEY=your_langsmith_key
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=waymates
